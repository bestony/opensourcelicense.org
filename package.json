{
  "name": "opensourcelicense-org",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && tsx scripts/offload/split.ts && pagefind --site dist && tsx scripts/offload/split.ts --check",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "pnpm build && pnpm offload:upload && wrangler deploy --var PAGES_VERSION:$(cat dist-r2/VERSION)",
    "offload:upload": "tsx scripts/offload/upload.ts",
    "cf:preview": "pnpm build && tsx scripts/offload/upload.ts --local && wrangler dev --var PAGES_VERSION:$(cat dist-r2/VERSION)",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "check": "astro check && tsc -p worker",
    "sync": "tsx scripts/sync/index.ts",
    "advisor:smoke": "tsx scripts/advisor-smoke.ts",
    "translate": "tsx scripts/translate/index.ts",
    "license-check": "tsx scripts/pr-license-check.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260925.1",
    "@iconify-json/devicon": "^1.2.67",
    "@iconify-json/lucide": "^1.2.136",
    "astro-icon": "^1.2.0",
    "lefthook": "^2.1.14",
    "opencc-js": "^1.4.2",
    "pagefind": "^1.5.2",
    "shadcn": "^4.21.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.140.0"
  }
}
