{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opensource-license-org",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Pages are linked without a trailing slash (astro trailingSlash: "never").
    "html_handling": "drop-trailing-slash",
    // /api/*, raw data/text endpoints, and the pages offloaded to R2 (src/domain/offload.ts).
    "run_worker_first": [
      "/api/*",
      "/data/*",
      "/texts/*",
      "/*/projects/*",
      "/*/scenarios/*/*",
      "!/*/projects/trends"
    ]
  },
  // Rate limiting is enabled once a KV namespace is bound:
  //   wrangler kv namespace create RATE_LIMIT
  // then add: "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "<id>" }]
  "ai": { "binding": "AI" },
  // Pages offloaded from the static assets (src/domain/offload.ts), uploaded by
  // "pnpm offload:upload". Create the bucket once: wrangler r2 bucket create opensourcelicense-pages
  "r2_buckets": [{ "binding": "PAGES", "bucket_name": "opensourcelicense-pages" }],
  "vars": {
    "ADVISOR_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "DAILY_LIMIT": "60",
    "LOG_LEVEL": "info",
    // Hostnames allowed to solve the Turnstile widget. Production only: local
    // development overrides this in .dev.vars.
    "TURNSTILE_HOSTNAMES": "opensourcelicense.org,www.opensourcelicense.org,opensource-license-org.floral-field-9262.workers.dev"
  },
  // Secrets (wrangler secret put ...): TURNSTILE_SECRET, SESSION_SECRET
  "observability": { "enabled": true }
}
