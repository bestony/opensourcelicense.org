---
import Layout from "@/layouts/main.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import Chat from "@/components/islands/Chat";
import { clientRaw } from "@/lib/client-data";
import type { Locale } from "@/lib/i18n";
import { localeStaticPaths, pageContext } from "@/lib/page";

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const { cat, t } = pageContext(locale);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<Layout locale={locale} title={t("chat.title")} wide>
  <PageHeader title={t("chat.title")} lead={t("chat.lead")} />
  <Chat client:load raw={clientRaw(cat, locale)} locale={locale} turnstileSiteKey={turnstileSiteKey || undefined} />
</Layout>
