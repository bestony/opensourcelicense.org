---
import Layout from "@/layouts/main.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import DepsCheck from "@/components/islands/DepsCheck";
import { clientRaw } from "@/lib/client-data";
import type { Locale } from "@/lib/i18n";
import { localeStaticPaths, pageContext } from "@/lib/page";

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const { cat, t } = pageContext(locale);
---

<Layout locale={locale} title={t("check.title")} description={t("check.lead")} noindex>
  <PageHeader title={t("check.title")} lead={t("check.lead")} />
  <DepsCheck client:load raw={clientRaw(cat, locale)} locale={locale} />
</Layout>
