---
import Layout from "@/layouts/main.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import ProjectMap from "@/components/islands/ProjectMap";
import { clientRaw } from "@/lib/client-data";
import type { Locale } from "@/lib/i18n";
import { localeStaticPaths, pageContext } from "@/lib/page";

export const getStaticPaths = localeStaticPaths;
const { locale } = Astro.props as { locale: Locale };
const { cat, t, href } = pageContext(locale);
---

<Layout locale={locale} title={t("projects.title")} description={t("projects.lead")} wide>
  <PageHeader title={t("projects.title")} lead={t("projects.lead")}>
    <p><a href={href("/projects/trends")}>{t("nav.trends")} →</a></p>
  </PageHeader>
  <ProjectMap client:load raw={clientRaw(cat, locale)} locale={locale} />
</Layout>
