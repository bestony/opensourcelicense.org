---
interface Props {
  title: string;
  lead?: string;
  /** Pagefind ranking weight for the title (Pagefind default for h1 is 7, max 10). */
  searchWeight?: number;
}
const { title, lead, searchWeight } = Astro.props;
---

<header class="mb-8 space-y-2">
  <h1 class="term-heading text-3xl text-primary md:text-4xl" data-pagefind-weight={searchWeight}>{title}<span class="cursor" aria-hidden="true"></span></h1>
  {lead && <p class="max-w-3xl text-lg text-muted-foreground">{lead}</p>}
  <slot />
</header>
