---
import type { Translator } from "@/lib/i18n";

interface Props {
  t: Translator;
  fallback: boolean;
  reviewed: boolean;
  isDefault: boolean;
  stale?: boolean;
}
const { t, fallback, reviewed, isDefault, stale = false } = Astro.props;
const base = fallback ? t("badge.fallback") : isDefault ? null : reviewed ? t("badge.reviewed") : t("badge.machine");
const label = base && stale ? `${base} · ${t("badge.stale")}` : base;
---

{label && <span class:list={["inline-block border px-1 text-sm", reviewed && !fallback && !stale ? "border-border text-muted-foreground" : "border-verdict-conditional text-verdict-conditional"]}>{label}</span>}
