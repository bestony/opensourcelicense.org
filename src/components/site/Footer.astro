---
import { Icon } from "astro-icon/components";
import type { Locale } from "@/lib/i18n";
import { issueUrl, pageContext, REPO_URL } from "@/lib/page";

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const { t } = pageContext(locale);
const report = issueUrl(`Data error on ${path}`, `Page: https://opensourcelicense.org${path}\n\nWhat is wrong:\n\nSource (official text or announcement):\n`);
---

<footer class="mt-12 border-t border-border">
  <div class="mx-auto max-w-7xl space-y-2 px-4 py-6 text-sm text-muted-foreground">
    <p>⚠ {t("footer.disclaimer")}</p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <a href={REPO_URL} rel="noopener">{t("footer.source")}</a>
      <a href={`${REPO_URL}/tree/main/data`} rel="noopener">{t("footer.data")}</a>
      <a href={report} rel="noopener">{t("footer.report")}</a>
      <span>{t("footer.cite")}</span>
    </p>
    <p class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-2">
      <a href="https://workers.cloudflare.com/" rel="noopener" class="inline-flex items-center gap-2">
        {/* The wordmark text is dark gray, so it needs a light plate on the dark theme. */}
        <span class="inline-flex bg-white p-0.5">
          <Icon name="devicon:cloudflareworkers-wordmark" class="size-10" aria-hidden="true" />
        </span>
        <span>{t("footer.hosting")}</span>
      </a>
      <a href="https://www.cloudflare.com/" rel="noopener" class="inline-flex items-center gap-2">
        <Icon name="devicon:cloudflare" class="size-8" aria-hidden="true" />
        <span>{t("footer.dns")}</span>
      </a>
    </p>
  </div>
</footer>
