---
import { Font } from "astro:assets";
import "@/styles/global.css";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import LangSuggest from "@/components/site/LangSuggest.astro";
import Analytics from "@/components/site/Analytics.astro";
import { DEFAULT_LOCALE, LOCALES, LOCALE_META } from "@/domain/locales";
import { localizedPath, stripLocale, type Locale } from "@/lib/i18n";
import { pageContext } from "@/lib/page";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  noindex?: boolean;
  wide?: boolean;
  /** Include this page in the on-site Pagefind index. */
  searchable?: boolean;
}

const { locale = DEFAULT_LOCALE, title, description, noindex = false, wide = false, searchable = true } = Astro.props;
const ctx = pageContext(locale);
const { t } = ctx;
const siteName = t("site.name");
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} — ${t("site.tagline")}`;
const desc = description ?? t("site.description");
const { path } = stripLocale(Astro.url.pathname);
const site = Astro.site ?? new URL("https://opensourcelicense.org");
const canonical = new URL(localizedPath(locale, path), site).href;
const meta = LOCALE_META[locale];
// hreflang alternates: every locale, plus regional aliases that point to the same page.
const alternates = LOCALES.flatMap((l) => {
  const href = new URL(localizedPath(l, path), site).href;
  return [LOCALE_META[l].tag, ...(LOCALE_META[l].hreflangAliases ?? [])].map((hreflang) => ({ hreflang, href }));
});
---

<html lang={meta.tag} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    <meta property="og:site_name" content="opensourcelicense.org" />
    <meta property="og:image" content={new URL("/og-default.png", site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL("/og-default.png", site).href} />
    <meta name="theme-color" content="#000000" />
    <Font cssVariable="--font-vt323" preload />
    <Analytics />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-2 focus:top-2 bg-primary text-primary-foreground px-2">Skip to content</a>
    <Header locale={locale} path={path} />
    <LangSuggest locale={locale} path={path} />
    <main id="main" class:list={["mx-auto w-full flex-1 px-4 py-8", wide ? "max-w-7xl" : "max-w-5xl"]} data-pagefind-body={searchable ? "" : undefined}>
      <slot />
    </main>
    <Footer locale={locale} path={path} />
  </body>
</html>
